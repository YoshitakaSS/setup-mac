# Apple Silicon 用 (brew/bootstrap.sh から使う)。Intel Mac は macports/bootstrap.sh を使う
# CLI の一覧は macports/bootstrap.sh の PORTS と揃える。違い: icu4c は依存で自動導入されるため書かない、ansible は MacPorts では py313-ansible

# CLI
brew "gh"
brew "ansible"
brew "mise"
brew "bat"
brew "bzip2"
brew "coreutils"
brew "libidn2"
brew "gnutls"
brew "emacs"
brew "curl"
brew "direnv"
brew "eza"
brew "fd"
brew "ghq"
brew "librsvg"
brew "graphviz"
brew "grep"
brew "jq"
brew "libxml2"
brew "libxmlsec1"
brew "mysql@8.4"
brew "nkf"
brew "oath-toolkit"
brew "peco"
brew "php@8.4"
brew "plantuml"
brew "ripgrep"
brew "starship"
brew "tree"
brew "wget"
brew "jnv"
brew "blueutil"

# GUI アプリ
